%% Setup
clear, clc, close all
%trajType = input('Enter trajectory type (trap, cubic, quintic, bspline): ', 's');
% Define waypoints and times (example values)
waypoints = [0.6 0.5 0 -0.8; -0.2 0 -0.25 -0.1; 0.6 0.3 1 0.65]; % Example waypoints
waypoints(:,4)=waypoints(:,1);
orientations = [0 0 0; 0 pi/4 0; 0 pi/2 0; 0 pi 0];
waypointTimes = [0 2 4 6]; % Time at each waypoint
waypointAccelTimes = [0.5 0.5 0.5]; % Acceleration time for each segment

% Define nonzero velocity boundary conditions for all joints
velocityBoundaryCondition = [0 0.5 0.5 0;  % Joint 1 velocities
                            0 1.0 1.0 0;  % Joint 2 velocities
                            0 1.5 1.5 0;  % Joint 3 velocities
                            0 0.2 0.2 0;  % Joint 4 velocities
                            0 0.1 0.1 0;  % Joint 5 velocities
                            0 0 0 0];     % Joint 6 velocities

% Define nonzero acceleration boundary conditions for all joints
accelerationBoundaryCondition = [0 0.2 0.2 0;  % Joint 1 accelerations
                                0 0.4 0.4 0;  % Joint 2 accelerations
                                0 0.6 0.6 0;  % Joint 3 accelerations
                                0 0.1 0.1 0;  % Joint 4 accelerations
                                0 0.05 0.05 0; % Joint 5 accelerations
                                0 0 0 0];     % Joint 6 accelerations

% Define home joint angles (example values)
jointAnglesHome = [0 0 0 0 0 0]; % Home configuration for PUMA

% Load PUMA robot model
puma = loadrobot('puma560', 'DataFormat', 'row');

% Define end effector name
eeName = 'link7';

% Use a small sample time for this example
ts = 0.01;
trajTimes = 0:ts:waypointTimes(end);

% Define threshold for small angles
angleThreshold = 0.0001;


% Define IK
ik = inverseKinematics('RigidBodyTree',puma);
ikWeights = [0 0 0 1 1 1];
ikInitGuess = jointAnglesHome;
ikInitGuess(ikInitGuess > pi) = ikInitGuess(ikInitGuess > pi) - 2*pi;
ikInitGuess(ikInitGuess < -pi) = ikInitGuess(ikInitGuess < -pi) + 2*pi;

% Set up plot
plotMode = 1; 
show(puma,puma.homeConfiguration,'Frames','off','PreservePlot',false);
xlim([-1 1]), ylim([-1 1]), zlim([0 1.2])
hold on
if plotMode == 1
    hTraj = plot3(waypoints(1,1),waypoints(2,1),waypoints(3,1),'b.-');
end
plot3(waypoints(1,:),waypoints(2,:),waypoints(3,:),'ro','LineWidth',2);

%% Solve IK for all waypoints and includeOrientation = false
includeOrientation = false; % Set this to use zero vs. nonzero orientations

numWaypoints = size(waypoints,2);
numJoints = numel(puma.homeConfiguration);
jointWaypoints = zeros(numJoints,numWaypoints);

for idx = 1:numWaypoints
    if includeOrientation
        tgtPose = trvec2tform(waypoints(:,idx)') * eul2tform(orientations(idx,:));
    else
        tgtPose =  trvec2tform(waypoints(:,idx)');
    end
    [config,info] = ik(eeName,tgtPose,ikWeights,ikInitGuess);
    ikInitGuess=config;
    jointWaypoints(:,idx) = config';
    
end

%% Generate trajectory on joint space
trajType = 'quintic';

switch trajType
    case 'trap'
        [q,qd,qdd] = trapveltraj(jointWaypoints,numel(trajTimes), ...
            'AccelTime',repmat(waypointAccelTimes,[numJoints 1]), ... 
            'EndTime',repmat(diff(waypointTimes),[numJoints 1]));
                            
    case 'cubic'
        [q,qd,qdd] = cubicpolytraj(jointWaypoints,waypointTimes,trajTimes, ... 
            'VelocityBoundaryCondition',zeros(numJoints,numWaypoints));
        
    case 'quintic'
        [q,qd,qdd] = quinticpolytraj(jointWaypoints,waypointTimes,trajTimes, ... 
            'VelocityBoundaryCondition',zeros(numJoints,numWaypoints), ...
            'AccelerationBoundaryCondition',zeros(numJoints,numWaypoints));
        
    case 'bspline'
        ctrlpoints = jointWaypoints; % Can adapt this as needed
        [q,qd,qdd] = bsplinepolytraj(ctrlpoints,waypointTimes([1 end]),trajTimes);
        
    otherwise
        error('Invalid trajectory type! Use ''trap'', ''cubic'', ''quintic'', or ''bspline''');
end

% Set small angles to zero
  q(abs(q) < angleThreshold) = 0;
%% Trajectory following loop
for idx = 1:numel(trajTimes) 

 
    config = q(:,idx)';
    
    % Find Cartesian points for visualization
    eeTform = getTransform(puma,config,eeName);
    eePos = tform2trvec(eeTform);
    % Define a small tolerance for comparison
     tolerance = 1e-3; % Adjust this value as needed

    % Check if eePos is close to any waypoint
     isMatch = any(all(abs(waypoints' - eePos) < tolerance, 2));
    if isMatch
         plotMode = 2;
         
    end
    if plotMode == 1
        
        set(hTraj,'xdata',[hTraj.XData eePos(1)], ...
                  'ydata',[hTraj.YData eePos(2)], ...
                  'zdata',[hTraj.ZData eePos(3)]);
    elseif plotMode == 2
        plotTransforms(tform2trvec(eeTform),tform2quat(eeTform),'FrameSize',0.1);
        plotMode = 1;
    end
    
    % Show the robot
    show(puma,config,'Frames','off','PreservePlot',false);
    title(['Trajectory at t = ' num2str(trajTimes(idx))])
    drawnow   
    
end

%% Plot task-space trajectory for includeOrientation = false (using jacobian matrix)
% Initialize arrays for task-space data
numSteps = numel(trajTimes);
eePos = zeros(3, numSteps); % End-effector position
eeOrient = zeros(3, numSteps); % End-effector orientation (roll, pitch, yaw)
eeVel = zeros(6, numSteps); % Task-space velocity (angular + linear)
eeAcc = zeros(6, numSteps); % Task-space acceleration (angular + linear)

% Loop through each time step to compute task-space data
for idx = 1:numSteps
  % Get joint configuration, velocity, and acceleration at this time step
  config = q(:, idx)';
  jointVel = qd(:, idx)';
  jointAcc = qdd(:, idx)';
  

   jointVel(abs(jointVel) < angleThreshold) = 0;
    jointAcc(abs( jointAcc) < angleThreshold) = 0;
  % Compute forward kinematics to get end-effector position and orientation
  eeTform = getTransform(puma, config, eeName); % End-effector transform
  eePos(:, idx) = tform2trvec(eeTform)'; % Extract position from transform
  eeOrient(:, idx) = tform2eul(eeTform)'; % Extract orientation (roll, pitch, yaw)

   eePos(abs( eePos) < angleThreshold) = 0;
   eeOrient(abs( eeOrient) < angleThreshold) = 0;
  % Compute Jacobian at the current configuration
  J = geometricJacobian(puma, config, eeName);

  % Compute task-space velocity: eeVel
  eeVel(1:3, idx) = J(1:3, :) * jointVel'; % Angular velocity (rotation)
  eeVel(4:6, idx) = J(4:6, :) * jointVel'; % Linear velocity (translation)

  % Compute task-space acceleration: eeAcc
  eeAcc(1:3, idx) = J(1:3, :) * jointAcc'; % Angular acceleration (rotation)
  eeAcc(4:6, idx) = J(4:6, :) * jointAcc'; % Linear acceleration (translation)
end
figure;

% Plot position
subplot(3, 1, 1);
plot(trajTimes, eePos(1, :), 'r', 'LineWidth', 1.5); hold on;
plot(trajTimes, eePos(2, :), 'g', 'LineWidth', 1.5);
plot(trajTimes, eePos(3, :), 'b', 'LineWidth', 1.5);
title('Task-Space Position');
xlabel('Time (s)');
ylabel('Position (m)');
legend('X', 'Y', 'Z');
grid on;

% Plot orientation (roll, pitch, yaw)
subplot(3, 1, 2);
plot(trajTimes, eeOrient(1, :), 'r', 'LineWidth', 1.5); hold on;
plot(trajTimes, eeOrient(2, :), 'g', 'LineWidth', 1.5);
plot(trajTimes, eeOrient(3, :), 'b', 'LineWidth', 1.5);
title('Task-Space Orientation (Roll, Pitch, Yaw)');
xlabel('Time (s)');
ylabel('Orientation (rad)');
legend('Roll', 'Pitch', 'Yaw');
grid on;

% Plot velocity (linear + angular)
subplot(3, 1, 3);
plot(trajTimes, eeVel(4, :), 'r', 'LineWidth', 1.5); hold on; % Linear X
plot(trajTimes, eeVel(5, :), 'g', 'LineWidth', 1.5); % Linear Y
plot(trajTimes, eeVel(6, :), 'b', 'LineWidth', 1.5); % Linear Z
plot(trajTimes, eeVel(1, :), 'c--', 'LineWidth', 1.5); % Angular X
plot(trajTimes, eeVel(2, :), 'm--', 'LineWidth', 1.5); % Angular Y
plot(trajTimes, eeVel(3, :), 'k--', 'LineWidth', 1.5); % Angular Z
title('Task-Space Velocity (Linear + Angular)');
xlabel('Time (s)');
ylabel('Velocity');
legend('Vx', 'Vy', 'Vz', 'Wx', 'Wy', 'Wz');
grid on;


figure;
plot(trajTimes, eeAcc(4, :), 'r', 'LineWidth', 1.5); hold on; % Linear X
plot(trajTimes, eeAcc(5, :), 'g', 'LineWidth', 1.5); % Linear Y
plot(trajTimes, eeAcc(6, :), 'b', 'LineWidth', 1.5); % Linear Z
plot(trajTimes, eeAcc(1, :), 'c--', 'LineWidth', 1.5); % Angular X
plot(trajTimes, eeAcc(2, :), 'm--', 'LineWidth', 1.5); % Angular Y
plot(trajTimes, eeAcc(3, :), 'k--', 'LineWidth', 1.5); % Angular Z
title('Task-Space Acceleration (Linear + Angular)');
xlabel('Time (s)');
ylabel('Acceleration');
legend('Ax', 'Ay', 'Az', 'AlphaX', 'AlphaY', 'AlphaZ');
grid on;



%% jerks
qdd=qdd';
jointJerks = zeros(numel(trajTimes), numJoints); % Initialize joint jerks
for tIdx = 1:numel(trajTimes)
            if tIdx>1  % Compute joint jerks
                jointJerks(tIdx, :) = (qdd(tIdx, :) - qdd(tIdx - 1, :)) /0.02;
            end
end

% Adjust time vector for jerk (exclude the first two time steps)
timeVectorJerk = trajTimes(3:end);

% Plot joint-space jerk
figure;
plot(timeVectorJerk, jointJerks(3:end, :), 'LineWidth', 1.5);
title('Joint-Space Jerks');
xlabel('Time (s)');
ylabel('Jerk (rad/s^3)');
legend(arrayfun(@(x) sprintf('Joint %d', x), 1:numJoints, 'UniformOutput', false));
grid on;

%%  task space graphs preperation for includeOrientation = false

% Initialize task-space trajectory storage
numTimeSteps = numel(trajTimes);
eePositions = zeros(3, numTimeSteps); % End-effector positions (x, y, z)
eeOrientations = zeros(3, numTimeSteps); % End-effector orientations (roll, pitch, yaw)

% Compute forward kinematics for each time step
for tIdx = 1:numTimeSteps
  % Get the joint configuration at the current time step
  jointConfig = q(:, tIdx)'; % Joint positions at time tIdx (row vector)

  % Compute the end-effector pose using forward kinematics
  eePose = getTransform(puma, jointConfig, eeName); % Replace 'puma' and 'eeName' with your robot and end-effector name

  % Extract position (x, y, z) from the transformation matrix
  eePositions(:, tIdx) = tform2trvec(eePose);

  % Extract orientation (roll, pitch, yaw) from the transformation matrix
  eeOrientations(:, tIdx) = tform2eul(eePose); % Orientation in ZYX Euler angles
end
% Set small angles to zero
  eePositions(abs(eePositions) < angleThreshold) = 0;
  eeOrientations(abs( eeOrientations) < angleThreshold) = 0;
  
% Compute task-space velocity (numerical differentiation)
dt = mean(diff(trajTimes)); % Time step
eeVelocities = diff(eePositions, 1, 2) / dt; % Velocity (x, y, z)
eeAngularVelocities = diff(eeOrientations, 1, 2) / dt; % Angular velocity (roll, pitch, yaw)

% Compute task-space acceleration (numerical differentiation)
eeAccelerations = diff(eeVelocities, 1, 2) / dt; % Acceleration (x, y, z)
eeAngularAccelerations = diff(eeAngularVelocities, 1, 2) / dt; % Angular acceleration (roll, pitch, yaw)

% Adjust time vectors for velocity and acceleration
trajTimesVel = trajTimes(1:end-1); % Time vector for velocity
trajTimesAcc = trajTimes(1:end-2); % Time vector for acceleration


%% Plot task-space position trajectory for includeOrientation = false
% Plot task-space position trajectory
figure;
subplot(3, 1, 1);
plot(trajTimes, eePositions(1, :), 'LineWidth', 1.5);
title('End-Effector X Position');
xlabel('Time (s)');
ylabel('X (m)');
grid on;

subplot(3, 1, 2);
plot(trajTimes, eePositions(2, :), 'LineWidth', 1.5);
title('End-Effector Y Position');
xlabel('Time (s)');
ylabel('Y (m)');
grid on;

subplot(3, 1, 3);
plot(trajTimes, eePositions(3, :), 'LineWidth', 1.5);
title('End-Effector Z Position');
xlabel('Time (s)');
ylabel('Z (m)');
grid on;

% Plot task-space velocity trajectory
figure;
subplot(3, 1, 1);
plot(trajTimesVel, eeVelocities(1, :), 'LineWidth', 1.5);
title('End-Effector X Velocity');
xlabel('Time (s)');
ylabel('Velocity X (m/s)');
grid on;

subplot(3, 1, 2);
plot(trajTimesVel, eeVelocities(2, :), 'LineWidth', 1.5);
title('End-Effector Y Velocity');
xlabel('Time (s)');
ylabel('Velocity Y (m/s)');
grid on;

subplot(3, 1, 3);
plot(trajTimesVel, eeVelocities(3, :), 'LineWidth', 1.5);
title('End-Effector Z Velocity');
xlabel('Time (s)');
ylabel('Velocity Z (m/s)');
grid on;

% Plot task-space acceleration trajectory
figure;
subplot(3, 1, 1);
plot(trajTimesAcc, eeAccelerations(1, :), 'LineWidth', 1.5);
title('End-Effector X Acceleration');
xlabel('Time (s)');
ylabel('Acceleration X (m/s^2)');
grid on;

subplot(3, 1, 2);
plot(trajTimesAcc, eeAccelerations(2, :), 'LineWidth', 1.5);
title('End-Effector Y Acceleration');
xlabel('Time (s)');
ylabel('Acceleration Y (m/s^2)');
grid on;

subplot(3, 1, 3);
plot(trajTimesAcc, eeAccelerations(3, :), 'LineWidth', 1.5);
title('End-Effector Z Acceleration');
xlabel('Time (s)');
ylabel('Acceleration Z (m/s^2)');
grid on;

% Plot task-space orientation position trajectory 
figure;
subplot(3, 1, 1);
plot(trajTimes, rad2deg(eeOrientations(1, :)), 'LineWidth', 1.5);
title('End-Effector Roll');
xlabel('Time (s)');
ylabel('Roll (°)');
grid on;

subplot(3, 1, 2);
plot(trajTimes, rad2deg(eeOrientations(2, :)), 'LineWidth', 1.5);
title('End-Effector Pitch');
xlabel('Time (s)');
ylabel('Pitch (°)');
grid on;

subplot(3, 1, 3);
plot(trajTimes, rad2deg(eeOrientations(3, :)), 'LineWidth', 1.5);
title('End-Effector Yaw');
xlabel('Time (s)');
ylabel('Yaw (°)');
grid on;

% Plot task-space  orientation velocity trajectory
figure;
subplot(3, 1, 1);
plot(trajTimesVel, eeAngularVelocities(1, :), 'LineWidth', 1.5);
title('End-Effector Roll Velocity');
xlabel('Time (s)');
ylabel(' Angular Velocity Roll (m/s)');
grid on;

subplot(3, 1, 2);
plot(trajTimesVel, eeAngularVelocities(2, :), 'LineWidth', 1.5);
title('End-Effector Pitch Velocity');
xlabel('Time (s)');
ylabel(' AngularVelocity Pitch (m/s)');
grid on;

subplot(3, 1, 3);
plot(trajTimesVel, eeAngularVelocities(3, :), 'LineWidth', 1.5);
title('End-Effector Yaw Velocity');
xlabel('Time (s)');
ylabel(' Angular Velocity Yaw (m/s)');
grid on;

% Plot task-space  orientation acceleration trajectory
figure;
subplot(3, 1, 1);
plot(trajTimesAcc, eeAngularAccelerations(1, :), 'LineWidth', 1.5);
title('End-Effector  Roll Acceleration');
xlabel('Time (s)');
ylabel('Angular Acceleration  Roll (m/s^2)');
grid on;

subplot(3, 1, 2);
plot(trajTimesAcc, eeAngularAccelerations(2, :), 'LineWidth', 1.5);
title('End-Effector Pitch Acceleration');
xlabel('Time (s)');
ylabel('Angular Acceleration Pitch (m/s^2)');
grid on;

subplot(3, 1, 3);
plot(trajTimesAcc, eeAngularAccelerations(3, :), 'LineWidth', 1.5);
title('End-Effector Yaw Acceleration ');
xlabel('Time (s)');
ylabel('Angular Acceleration Yaw (m/s^2)');
grid on;


% 3D Plot of the end-effector trajectory in task space
figure;
plot3(eePositions(1, :), eePositions(2, :), eePositions(3, :), 'b-', 'LineWidth', 1.5);
hold on;
plot3(waypoints(1, :), waypoints(2, :), waypoints(3, :), 'ro', 'MarkerSize', 6); % Mark waypoints
title('End-Effector Task-Space Trajectory (includeOrientation = false)');
xlabel('X (m)');
ylabel('Y (m)');
zlabel('Z (m)');
grid on;
legend('Trajectory', 'Waypoints');
%%  task space graphs preperation for includeOrientation = true
includeOrientation = true;
for idx = 1:numWaypoints
    if includeOrientation
        tgtPose = trvec2tform(waypoints(:,idx)') * eul2tform(orientations(idx,:));
    else
        tgtPose =  trvec2tform(waypoints(:,idx)');
    end
    [config,info] = ik(eeName,tgtPose,ikWeights,ikInitGuess);
    ikInitGuess=config;
    jointWaypoints(:,idx) = config';
    
end
switch trajType
    case 'trap'
        [qf,qfd,qfdd] = trapveltraj(jointWaypoints,numel(trajTimes), ...
            'AccelTime',repmat(waypointAccelTimes,[numJoints 1]), ... 
            'EndTime',repmat(diff(waypointTimes),[numJoints 1]));
                            
    case 'cubic'
        [qf,qfd,qfdd] = cubicpolytraj(jointWaypoints,waypointTimes,trajTimes, ... 
            'VelocityBoundaryCondition',zeros(numJoints,numWaypoints));
        
    case 'quintic'
        [qf,qfd,qfdd] = quinticpolytraj(jointWaypoints,waypointTimes,trajTimes, ... 
            'VelocityBoundaryCondition',zeros(numJoints,numWaypoints), ...
            'AccelerationBoundaryCondition',zeros(numJoints,numWaypoints));
        
    case 'bspline'
        ctrlpoints = jointWaypoints; % Can adapt this as needed
        [qf,qfd,qfdd] = bsplinepolytraj(ctrlpoints,waypointTimes([1 end]),trajTimes);
        
    otherwise
        error('Invalid trajectory type! Use ''trap'', ''cubic'', ''quintic'', or ''bspline''');
end
 % Set small angles to zero
  qf(abs(qf) < angleThreshold) = 0;                          
eePositions2 = zeros(3, numTimeSteps); % End-effector positions (x, y, z)
eeOrientations2 = zeros(3, numTimeSteps); % End-effector orientations (roll, pitch, yaw)

for tIdx = 1:numTimeSteps
  % Get the joint configuration at the current time step
  jointConfig = qf(:, tIdx)'; % Joint positions at time tIdx (row vector)

  % Compute the end-effector pose using forward kinematics
  eePose = getTransform(puma, jointConfig, eeName); % Replace 'puma' and 'eeName' with your robot and end-effector name

  % Extract position (x, y, z) from the transformation matrix
  eePositions2(:, tIdx) = tform2trvec(eePose);

  % Extract orientation (roll, pitch, yaw) from the transformation matrix
  eeOrientations2(:, tIdx) = tform2eul(eePose); % Orientation in ZYX Euler angles
end

% Set small angles to zero
  eePositions2(abs(eePositions2) < angleThreshold) = 0;
  eeOrientations2(abs( eeOrientations2) < angleThreshold) = 0;
% Compute task-space velocity (numerical differentiation)

eeVelocities2 = diff(eePositions2, 1, 2) / dt; % Velocity (x, y, z)
eeAngularVelocities2 = diff(eeOrientations2, 1, 2) / dt; % Angular velocity (roll, pitch, yaw)

% Compute task-space acceleration (numerical differentiation)
eeAccelerations2 = diff(eeVelocities2, 1, 2) / dt; % Acceleration (x, y, z)
eeAngularAccelerations2 = diff(eeAngularVelocities2, 1, 2) / dt; % Angular acceleration (roll, pitch, yaw)
%% Plot task-space position trajectory for includeOrientation = true
% Plot task-space position trajectory
figure;
subplot(3, 1, 1);
plot(trajTimes, eePositions2(1, :), 'r', 'LineWidth', 1.5);
title('End-Effector X Position');
xlabel('Time (s)');
ylabel('X (m)');
grid on;

subplot(3, 1, 2);
plot(trajTimes, eePositions2(2, :), 'r', 'LineWidth', 1.5);
title('End-Effector Y Position');
xlabel('Time (s)');
ylabel('Y (m)');
grid on;

subplot(3, 1, 3);
plot(trajTimes, eePositions2(3, :), 'r', 'LineWidth', 1.5);
title('End-Effector Z Position');
xlabel('Time (s)');
ylabel('Z (m)');
grid on;

% Plot task-space velocity trajectory
figure;
subplot(3, 1, 1);
plot(trajTimesVel, eeVelocities2(1, :), 'r', 'LineWidth', 1.5);
title('End-Effector X Velocity');
xlabel('Time (s)');
ylabel('Velocity X (m/s)');
grid on;

subplot(3, 1, 2);
plot(trajTimesVel, eeVelocities2(2, :), 'r', 'LineWidth', 1.5);
title('End-Effector Y Velocity');
xlabel('Time (s)');
ylabel('Velocity Y (m/s)');
grid on;

subplot(3, 1, 3);
plot(trajTimesVel, eeVelocities2(3, :), 'r', 'LineWidth', 1.5);
title('End-Effector Z Velocity');
xlabel('Time (s)');
ylabel('Velocity Z (m/s)');
grid on;

% Plot task-space acceleration trajectory
figure;
subplot(3, 1, 1);
plot(trajTimesAcc, eeAccelerations2(1, :), 'r', 'LineWidth', 1.5);
title('End-Effector X Acceleration');
xlabel('Time (s)');
ylabel('Acceleration X (m/s^2)');
grid on;

subplot(3, 1, 2);
plot(trajTimesAcc, eeAccelerations2(2, :), 'r', 'LineWidth', 1.5);
title('End-Effector Y Acceleration');
xlabel('Time (s)');
ylabel('Acceleration Y (m/s^2)');
grid on;

subplot(3, 1, 3);
plot(trajTimesAcc, eeAccelerations2(3, :), 'r', 'LineWidth', 1.5);
title('End-Effector Z Acceleration');
xlabel('Time (s)');
ylabel('Acceleration Z (m/s^2)');
grid on;

% Plot task-space orientation position trajectory 
figure;
subplot(3, 1, 1);
plot(trajTimes, rad2deg(eeOrientations2(1, :)), 'r', 'LineWidth', 1.5);
title('End-Effector Roll');
xlabel('Time (s)');
ylabel('Roll (°)');
grid on;

subplot(3, 1, 2);
plot(trajTimes, rad2deg(eeOrientations2(2, :)), 'r', 'LineWidth', 1.5);
title('End-Effector Pitch');
xlabel('Time (s)');
ylabel('Pitch (°)');
grid on;

subplot(3, 1, 3);
plot(trajTimes, rad2deg(eeOrientations2(3, :)), 'r', 'LineWidth', 1.5);
title('End-Effector Yaw');
xlabel('Time (s)');
ylabel('Yaw (°)');
grid on;

% Plot task-space  orientation velocity trajectory
figure;
subplot(3, 1, 1);
plot(trajTimesVel, eeAngularVelocities2(1, :), 'r', 'LineWidth', 1.5);
title('End-Effector Roll Velocity');
xlabel('Time (s)');
ylabel(' Angular Velocity Roll (m/s)');
grid on;

subplot(3, 1, 2);
plot(trajTimesVel, eeAngularVelocities2(2, :), 'r', 'LineWidth', 1.5);
title('End-Effector Pitch Velocity');
xlabel('Time (s)');
ylabel(' AngularVelocity Pitch (m/s)');
grid on;

subplot(3, 1, 3);
plot(trajTimesVel, eeAngularVelocities2(3, :), 'r', 'LineWidth', 1.5);
title('End-Effector Yaw Velocity');
xlabel('Time (s)');
ylabel(' Angular Velocity Yaw (m/s)');
grid on;

% Plot task-space  orientation acceleration trajectory
figure;
subplot(3, 1, 1);
plot(trajTimesAcc, eeAngularAccelerations2(1, :), 'r', 'LineWidth', 1.5);
title('End-Effector  Roll Acceleration');
xlabel('Time (s)');
ylabel('Angular Acceleration  Roll (m/s^2)');
grid on;

subplot(3, 1, 2);
plot(trajTimesAcc, eeAngularAccelerations2(2, :), 'r', 'LineWidth', 1.5);
title('End-Effector Pitch Acceleration');
xlabel('Time (s)');
ylabel('Angular Acceleration Pitch (m/s^2)');
grid on;

subplot(3, 1, 3);
plot(trajTimesAcc, eeAngularAccelerations2(3, :), 'r', 'LineWidth', 1.5);
title('End-Effector Yaw Acceleration ');
xlabel('Time (s)');
ylabel('Angular Acceleration Yaw (m/s^2)');
grid on;
% 3D Plot of the end-effector trajectory in task space
figure;
plot3(eePositions2(1, :), eePositions2(2, :), eePositions2(3, :), 'r-', 'LineWidth', 1.5);
hold on;
plot3(waypoints(1, :), waypoints(2, :), waypoints(3, :), 'bo', 'MarkerSize', 6); % Mark waypoints
title('End-Effector Task-Space Trajectory  includeOrientation = true');
xlabel('X (m)');
ylabel('Y (m)');
zlabel('Z (m)');
grid on;
legend('Trajectory ', 'Waypoints');
%% results for joint space and task space
     for i = 1:numJoints
         figure, hold on;
         plot(trajTimes, q(i, :), 'LineWidth', 1.5);
          plot(trajTimes, qf(i, :), 'LineWidth', 1.5);
         for wIdx = 1:numWaypoints
               xline(waypointTimes(wIdx), 'k--');
          end
         title(['Joint ', num2str(i), ' Position']);
         xlabel('Time (s)');
         ylabel('Position (rad)');
         legend('includeOrientation = false', 'includeOrientation = true');
     end

%% results for joint space for includeOrientation = false

for i = 1:numJoints
  % Create a new figure for each joint
  figure;

  % Plot joint position
  subplot(3, 1, 1); % First subplot for position
  hold on;
  plot(trajTimes, q(i, :), 'LineWidth', 1.5);
  for wIdx = 1:numWaypoints
      xline(waypointTimes(wIdx), 'k--'); % Mark waypoint times
  end
  plot(waypointTimes, jointWaypoints(i, :), 'ro', 'MarkerSize', 2); % Mark waypoints
  title(['Joint ', num2str(i) '  includeOrientation = false', ' Position']);
  xlabel('Time (s)');
  ylabel('Position (rad)');
  legend('Trajectory', 'Waypoints');
  grid on;

  % Plot joint velocity
  subplot(3, 1, 2); % Second subplot for velocity
  hold on;
  plot(trajTimes, qd(i, :), 'LineWidth', 1.5);
  for wIdx = 1:numWaypoints
      xline(waypointTimes(wIdx), 'k--'); % Mark waypoint times
  end
  title(['Joint ', num2str(i) '  includeOrientation = false', ' Velocity']);
  xlabel('Time (s)');
  ylabel('Velocity (rad/s)');
  legend('Trajectory', 'Waypoints');
  grid on;

  % Plot joint acceleration
  subplot(3, 1, 3); % Third subplot for acceleration
  hold on;
  plot(trajTimes, qdd(i, :), 'LineWidth', 1.5);
  for wIdx = 1:numWaypoints
      xline(waypointTimes(wIdx), 'k--'); % Mark waypoint times
  end
  title(['Joint ', num2str(i) '  includeOrientation = false', ' Acceleration']);
  xlabel('Time (s)');
  ylabel('Acceleration (rad/s^2)');
  legend('Trajectory', 'Waypoints');
  grid on;
end
%% results for joint space for includeOrientation = true

for i = 1:numJoints
  % Create a new figure for each joint
  figure;

  % Plot joint position
  subplot(3, 1, 1); % First subplot for position
  hold on;
  plot(trajTimes, qf(i, :), 'r', 'LineWidth', 1.5);
  for wIdx = 1:numWaypoints
      xline(waypointTimes(wIdx), 'k--'); % Mark waypoint times
  end
  plot(waypointTimes, jointWaypoints(i, :), 'ro', 'MarkerSize', 2); % Mark waypoints
  title(['Joint ', num2str(i) '  includeOrientation = true', ' Position']);
  xlabel('Time (s)');
  ylabel('Position (rad)');
  legend('Trajectory', 'Waypoints');
  grid on;

  % Plot joint velocity
  subplot(3, 1, 2); % Second subplot for velocity
  hold on;
  plot(trajTimes, qfd(i, :), 'r', 'LineWidth', 1.5);
  for wIdx = 1:numWaypoints
      xline(waypointTimes(wIdx), 'k--'); % Mark waypoint times
  end
  title(['Joint ', num2str(i) '  includeOrientation = true', ' Velocity']);
  xlabel('Time (s)');
  ylabel('Velocity (rad/s)');
  legend('Trajectory', 'Waypoints');
  grid on;

  % Plot joint acceleration
  subplot(3, 1, 3); % Third subplot for acceleration
  hold on;
  plot(trajTimes, qfdd(i, :), 'r', 'LineWidth', 1.5);
  for wIdx = 1:numWaypoints
      xline(waypointTimes(wIdx), 'k--'); % Mark waypoint times
  end
  title(['Joint ', num2str(i) '  includeOrientation = true', ' Acceleration']);
  xlabel('Time (s)');
  ylabel('Acceleration (rad/s^2)');
  legend('Trajectory', 'Waypoints');
  grid on;
end